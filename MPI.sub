#!/bin/bash
#SBATCH -N 1                # Nombre de nodes
#SBATCH -n 12               # Valor per defecte (si no s'indica el contrari)
#SBATCH --exclusive
#SBATCH --partition=nodo.q

# Carregar mòduls de GCC i OpenMPI
module load gcc/13.2.1
module load openmpi/4.1.1

# Compilació amb mpicc
mpicc -Ofast -march=native -fno-tree-vectorize -fopt-info-vec-optimized main.c common/common.c configuration/config.c layer/layer.c randomizer/randomizer.c initialize/initialize.c training/training.c -o exec$1 -lm

echo "Compilat correctament per a ${2} processos"

# Execució amb mpirun utilitzant el segon argument com a nombre de processos (-np)
perf stat mpirun -np ${2} ./exec$1 configuration/configfile.txt

# Neteja de l'executable temporal
rm ./exec$1